;; Laboratorium języka · mnożenie macierzy i uwaga w WebAssembly z SIMD (f32x4: 4 liczby jedną instrukcją).
;; Źródło dla lang/js/wasm.js; kompilacja: node lang/tools/build_wasm.js
;; Wszystkie macierze float32, wiersz po wierszu; adresy w bajtach. acc=0: wynik nadpisuje C, acc=1: dodaje.
(module
  (memory (export "mem") 1)

  ;; C[n,m] (+)= A[n,k] · B[k,m]      (kolejność i-p-j: wiersz B mnożony przez jedną liczbę A, 4 kolumny naraz)
  (func (export "mm") (param $a i32) (param $b i32) (param $c i32) (param $n i32) (param $k i32) (param $m i32) (param $acc i32)
    (local $i i32) (local $p i32) (local $j i32) (local $crow i32) (local $brow i32) (local $av f32) (local $vs v128) (local $m4 i32) (local $q i32)
    (if (i32.eqz (local.get $acc)) (then (memory.fill (local.get $c) (i32.const 0) (i32.mul (i32.mul (local.get $n) (local.get $m)) (i32.const 4)))))
    (local.set $m4 (i32.and (local.get $m) (i32.const -4)))
    (block $bi (loop $li
      (br_if $bi (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $crow (i32.add (local.get $c) (i32.shl (i32.mul (local.get $i) (local.get $m)) (i32.const 2))))
      (local.set $p (i32.const 0))
      (block $bp (loop $lp
        (br_if $bp (i32.ge_u (local.get $p) (local.get $k)))
        (local.set $av (f32.load (i32.add (local.get $a) (i32.shl (i32.add (i32.mul (local.get $i) (local.get $k)) (local.get $p)) (i32.const 2)))))
        (if (f32.ne (local.get $av) (f32.const 0)) (then
          (local.set $vs (f32x4.splat (local.get $av)))
          (local.set $brow (i32.add (local.get $b) (i32.shl (i32.mul (local.get $p) (local.get $m)) (i32.const 2))))
          (local.set $j (i32.const 0))
          (block $bj (loop $lj
            (br_if $bj (i32.ge_u (local.get $j) (local.get $m4)))
            (local.set $q (i32.shl (local.get $j) (i32.const 2)))
            (v128.store (i32.add (local.get $crow) (local.get $q))
              (f32x4.add (v128.load (i32.add (local.get $crow) (local.get $q)))
                         (f32x4.mul (local.get $vs) (v128.load (i32.add (local.get $brow) (local.get $q))))))
            (local.set $j (i32.add (local.get $j) (i32.const 4)))
            (br $lj)))
          (block $bt (loop $lt
            (br_if $bt (i32.ge_u (local.get $j) (local.get $m)))
            (local.set $q (i32.shl (local.get $j) (i32.const 2)))
            (f32.store (i32.add (local.get $crow) (local.get $q))
              (f32.add (f32.load (i32.add (local.get $crow) (local.get $q)))
                       (f32.mul (local.get $av) (f32.load (i32.add (local.get $brow) (local.get $q))))))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $lt)))))
        (local.set $p (i32.add (local.get $p) (i32.const 1)))
        (br $lp)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $li))))

  ;; C[n,m] (+)= A[n,k] · Bᵀ, gdzie B zapisane jako [m,k]: C[i,j] = iloczyn skalarny wiersza i z A i wiersza j z B
  (func (export "mmTB") (param $a i32) (param $b i32) (param $c i32) (param $n i32) (param $k i32) (param $m i32) (param $acc i32)
    (local $i i32) (local $j i32) (local $p i32) (local $arow i32) (local $brow i32) (local $s v128) (local $t f32) (local $k4 i32) (local $q i32) (local $ca i32)
    (local.set $k4 (i32.and (local.get $k) (i32.const -4)))
    (block $bi (loop $li
      (br_if $bi (i32.ge_u (local.get $i) (local.get $n)))
      (local.set $arow (i32.add (local.get $a) (i32.shl (i32.mul (local.get $i) (local.get $k)) (i32.const 2))))
      (local.set $j (i32.const 0))
      (block $bj (loop $lj
        (br_if $bj (i32.ge_u (local.get $j) (local.get $m)))
        (local.set $brow (i32.add (local.get $b) (i32.shl (i32.mul (local.get $j) (local.get $k)) (i32.const 2))))
        (local.set $s (v128.const f32x4 0 0 0 0))
        (local.set $p (i32.const 0))
        (block $bp (loop $lp
          (br_if $bp (i32.ge_u (local.get $p) (local.get $k4)))
          (local.set $q (i32.shl (local.get $p) (i32.const 2)))
          (local.set $s (f32x4.add (local.get $s) (f32x4.mul (v128.load (i32.add (local.get $arow) (local.get $q))) (v128.load (i32.add (local.get $brow) (local.get $q))))))
          (local.set $p (i32.add (local.get $p) (i32.const 4)))
          (br $lp)))
        (local.set $t (f32.add (f32.add (f32x4.extract_lane 0 (local.get $s)) (f32x4.extract_lane 1 (local.get $s)))
                               (f32.add (f32x4.extract_lane 2 (local.get $s)) (f32x4.extract_lane 3 (local.get $s)))))
        (block $bt (loop $lt
          (br_if $bt (i32.ge_u (local.get $p) (local.get $k)))
          (local.set $q (i32.shl (local.get $p) (i32.const 2)))
          (local.set $t (f32.add (local.get $t) (f32.mul (f32.load (i32.add (local.get $arow) (local.get $q))) (f32.load (i32.add (local.get $brow) (local.get $q))))))
          (local.set $p (i32.add (local.get $p) (i32.const 1)))
          (br $lt)))
        (local.set $ca (i32.add (local.get $c) (i32.shl (i32.add (i32.mul (local.get $i) (local.get $m)) (local.get $j)) (i32.const 2))))
        (if (local.get $acc) (then (local.set $t (f32.add (local.get $t) (f32.load (local.get $ca))))))
        (f32.store (local.get $ca) (local.get $t))
        (local.set $j (i32.add (local.get $j) (i32.const 1)))
        (br $lj)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br $li))))

  ;; C[n,m] (+)= Aᵀ · B, gdzie A zapisane jako [k,n]: dla każdego p wiersz p z B dodawany do wierszy C z wagami A[p,i]
  (func (export "mmTA") (param $a i32) (param $b i32) (param $c i32) (param $n i32) (param $k i32) (param $m i32) (param $acc i32)
    (local $i i32) (local $p i32) (local $j i32) (local $crow i32) (local $brow i32) (local $av f32) (local $vs v128) (local $m4 i32) (local $q i32)
    (if (i32.eqz (local.get $acc)) (then (memory.fill (local.get $c) (i32.const 0) (i32.mul (i32.mul (local.get $n) (local.get $m)) (i32.const 4)))))
    (local.set $m4 (i32.and (local.get $m) (i32.const -4)))
    (block $bp (loop $lp
      (br_if $bp (i32.ge_u (local.get $p) (local.get $k)))
      (local.set $brow (i32.add (local.get $b) (i32.shl (i32.mul (local.get $p) (local.get $m)) (i32.const 2))))
      (local.set $i (i32.const 0))
      (block $bi (loop $li
        (br_if $bi (i32.ge_u (local.get $i) (local.get $n)))
        (local.set $av (f32.load (i32.add (local.get $a) (i32.shl (i32.add (i32.mul (local.get $p) (local.get $n)) (local.get $i)) (i32.const 2)))))
        (if (f32.ne (local.get $av) (f32.const 0)) (then
          (local.set $vs (f32x4.splat (local.get $av)))
          (local.set $crow (i32.add (local.get $c) (i32.shl (i32.mul (local.get $i) (local.get $m)) (i32.const 2))))
          (local.set $j (i32.const 0))
          (block $bj (loop $lj
            (br_if $bj (i32.ge_u (local.get $j) (local.get $m4)))
            (local.set $q (i32.shl (local.get $j) (i32.const 2)))
            (v128.store (i32.add (local.get $crow) (local.get $q))
              (f32x4.add (v128.load (i32.add (local.get $crow) (local.get $q)))
                         (f32x4.mul (local.get $vs) (v128.load (i32.add (local.get $brow) (local.get $q))))))
            (local.set $j (i32.add (local.get $j) (i32.const 4)))
            (br $lj)))
          (block $bt (loop $lt
            (br_if $bt (i32.ge_u (local.get $j) (local.get $m)))
            (local.set $q (i32.shl (local.get $j) (i32.const 2)))
            (f32.store (i32.add (local.get $crow) (local.get $q))
              (f32.add (f32.load (i32.add (local.get $crow) (local.get $q)))
                       (f32.mul (local.get $av) (f32.load (i32.add (local.get $brow) (local.get $q))))))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br $lt)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $li)))
      (local.set $p (i32.add (local.get $p) (i32.const 1)))
      (br $lp))))

  ;; ---------- uwaga przyczynowa (części O(T²·hd); softmax i jego pochodna liczy JS, bo WASM nie ma exp) ----------
  ;; qkv: [B·T, 3d] (Q | K | V), A i S: [B, nh, T, T], O / dO: [B·T, d]. hd = d/nh, podzielne przez 4.
  (func $dot (param $x i32) (param $y i32) (param $n i32) (result f32)
    (local $k i32) (local $s v128)
    (local.set $s (v128.const f32x4 0 0 0 0))
    (block $b (loop $l
      (br_if $b (i32.ge_u (local.get $k) (local.get $n)))
      (local.set $s (f32x4.add (local.get $s) (f32x4.mul (v128.load (i32.add (local.get $x) (i32.shl (local.get $k) (i32.const 2))))
                                                         (v128.load (i32.add (local.get $y) (i32.shl (local.get $k) (i32.const 2)))))))
      (local.set $k (i32.add (local.get $k) (i32.const 4)))
      (br $l)))
    (f32.add (f32.add (f32x4.extract_lane 0 (local.get $s)) (f32x4.extract_lane 1 (local.get $s)))
             (f32.add (f32x4.extract_lane 2 (local.get $s)) (f32x4.extract_lane 3 (local.get $s)))))
  ;; dst[0..n) += a · src[0..n)
  (func $axpy (param $d i32) (param $s i32) (param $a f32) (param $n i32)
    (local $k i32) (local $va v128) (local $q i32)
    (local.set $va (f32x4.splat (local.get $a)))
    (block $b (loop $l
      (br_if $b (i32.ge_u (local.get $k) (local.get $n)))
      (local.set $q (i32.shl (local.get $k) (i32.const 2)))
      (v128.store (i32.add (local.get $d) (local.get $q))
        (f32x4.add (v128.load (i32.add (local.get $d) (local.get $q))) (f32x4.mul (local.get $va) (v128.load (i32.add (local.get $s) (local.get $q))))))
      (local.set $k (i32.add (local.get $k) (i32.const 4)))
      (br $l))))
  ;; adres wiersza t okna b w qkv, przesunięty o off liczb (0 = Q, d = K, 2d = V) i głowę h
  (func $row (param $q i32) (param $b i32) (param $t i32) (param $T i32) (param $d i32) (param $off i32) (result i32)
    (i32.add (local.get $q) (i32.shl (i32.add (i32.mul (i32.add (i32.mul (local.get $b) (local.get $T)) (local.get $t)) (i32.mul (local.get $d) (i32.const 3))) (local.get $off)) (i32.const 2))))
  ;; A[b,h,i,j] = sc · Q_i·K_j dla j ≤ i, 0 dla j > i
  (func (export "attScores") (param $q i32) (param $a i32) (param $B i32) (param $T i32) (param $d i32) (param $nh i32) (param $sc f32)
    (local $b i32) (local $h i32) (local $i i32) (local $j i32) (local $hd i32) (local $qi i32) (local $ab i32)
    (local.set $hd (i32.div_u (local.get $d) (local.get $nh)))
    (block $bb (loop $lb (br_if $bb (i32.ge_u (local.get $b) (local.get $B)))
      (local.set $h (i32.const 0))
      (block $bh (loop $lh (br_if $bh (i32.ge_u (local.get $h) (local.get $nh)))
        (local.set $i (i32.const 0))
        (block $bi (loop $li (br_if $bi (i32.ge_u (local.get $i) (local.get $T)))
          (local.set $qi (call $row (local.get $q) (local.get $b) (local.get $i) (local.get $T) (local.get $d) (i32.mul (local.get $h) (local.get $hd))))
          (local.set $ab (i32.add (local.get $a) (i32.shl (i32.mul (i32.add (i32.mul (i32.add (i32.mul (local.get $b) (local.get $nh)) (local.get $h)) (local.get $T)) (local.get $i)) (local.get $T)) (i32.const 2))))
          (local.set $j (i32.const 0))
          (block $bj (loop $lj (br_if $bj (i32.ge_u (local.get $j) (local.get $T)))
            (if (i32.le_u (local.get $j) (local.get $i))
              (then (f32.store (i32.add (local.get $ab) (i32.shl (local.get $j) (i32.const 2)))
                      (f32.mul (local.get $sc) (call $dot (local.get $qi)
                        (call $row (local.get $q) (local.get $b) (local.get $j) (local.get $T) (local.get $d) (i32.add (local.get $d) (i32.mul (local.get $h) (local.get $hd))))
                        (local.get $hd)))))
              (else (f32.store (i32.add (local.get $ab) (i32.shl (local.get $j) (i32.const 2))) (f32.const 0))))
            (local.set $j (i32.add (local.get $j) (i32.const 1))) (br $lj)))
          (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $li)))
        (local.set $h (i32.add (local.get $h) (i32.const 1))) (br $lh)))
      (local.set $b (i32.add (local.get $b) (i32.const 1))) (br $lb))))
  ;; O_i (głowa h) = Σ_{j ≤ i} A[i,j] · V_j
  (func (export "attOut") (param $q i32) (param $a i32) (param $o i32) (param $B i32) (param $T i32) (param $d i32) (param $nh i32)
    (local $b i32) (local $h i32) (local $i i32) (local $j i32) (local $hd i32) (local $oi i32) (local $ab i32) (local $p f32)
    (local.set $hd (i32.div_u (local.get $d) (local.get $nh)))
    (memory.fill (local.get $o) (i32.const 0) (i32.shl (i32.mul (i32.mul (local.get $B) (local.get $T)) (local.get $d)) (i32.const 2)))
    (block $bb (loop $lb (br_if $bb (i32.ge_u (local.get $b) (local.get $B)))
      (local.set $h (i32.const 0))
      (block $bh (loop $lh (br_if $bh (i32.ge_u (local.get $h) (local.get $nh)))
        (local.set $i (i32.const 0))
        (block $bi (loop $li (br_if $bi (i32.ge_u (local.get $i) (local.get $T)))
          (local.set $oi (i32.add (local.get $o) (i32.shl (i32.add (i32.mul (i32.add (i32.mul (local.get $b) (local.get $T)) (local.get $i)) (local.get $d)) (i32.mul (local.get $h) (local.get $hd))) (i32.const 2))))
          (local.set $ab (i32.add (local.get $a) (i32.shl (i32.mul (i32.add (i32.mul (i32.add (i32.mul (local.get $b) (local.get $nh)) (local.get $h)) (local.get $T)) (local.get $i)) (local.get $T)) (i32.const 2))))
          (local.set $j (i32.const 0))
          (block $bj (loop $lj (br_if $bj (i32.gt_u (local.get $j) (local.get $i)))
            (local.set $p (f32.load (i32.add (local.get $ab) (i32.shl (local.get $j) (i32.const 2)))))
            (if (f32.ne (local.get $p) (f32.const 0)) (then
              (call $axpy (local.get $oi) (call $row (local.get $q) (local.get $b) (local.get $j) (local.get $T) (local.get $d) (i32.add (i32.shl (local.get $d) (i32.const 1)) (i32.mul (local.get $h) (local.get $hd)))) (local.get $p) (local.get $hd))))
            (local.set $j (i32.add (local.get $j) (i32.const 1))) (br $lj)))
          (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $li)))
        (local.set $h (i32.add (local.get $h) (i32.const 1))) (br $lh)))
      (local.set $b (i32.add (local.get $b) (i32.const 1))) (br $lb))))
  ;; wstecz 1: S[i,j] = dO_i · V_j  (do pochodnej softmaksu) i gV_j += A[i,j] · dO_i
  (func (export "attBackP") (param $q i32) (param $a i32) (param $go i32) (param $s i32) (param $g i32) (param $B i32) (param $T i32) (param $d i32) (param $nh i32)
    (local $b i32) (local $h i32) (local $i i32) (local $j i32) (local $hd i32) (local $oi i32) (local $ab i32) (local $sb i32) (local $vo i32)
    (local.set $hd (i32.div_u (local.get $d) (local.get $nh)))
    (block $bb (loop $lb (br_if $bb (i32.ge_u (local.get $b) (local.get $B)))
      (local.set $h (i32.const 0))
      (block $bh (loop $lh (br_if $bh (i32.ge_u (local.get $h) (local.get $nh)))
        (local.set $vo (i32.add (i32.shl (local.get $d) (i32.const 1)) (i32.mul (local.get $h) (local.get $hd))))
        (local.set $i (i32.const 0))
        (block $bi (loop $li (br_if $bi (i32.ge_u (local.get $i) (local.get $T)))
          (local.set $oi (i32.add (local.get $go) (i32.shl (i32.add (i32.mul (i32.add (i32.mul (local.get $b) (local.get $T)) (local.get $i)) (local.get $d)) (i32.mul (local.get $h) (local.get $hd))) (i32.const 2))))
          (local.set $ab (i32.shl (i32.mul (i32.add (i32.mul (i32.add (i32.mul (local.get $b) (local.get $nh)) (local.get $h)) (local.get $T)) (local.get $i)) (local.get $T)) (i32.const 2)))
          (local.set $j (i32.const 0))
          (block $bj (loop $lj (br_if $bj (i32.gt_u (local.get $j) (local.get $i)))
            (f32.store (i32.add (i32.add (local.get $s) (local.get $ab)) (i32.shl (local.get $j) (i32.const 2)))
              (call $dot (local.get $oi) (call $row (local.get $q) (local.get $b) (local.get $j) (local.get $T) (local.get $d) (local.get $vo)) (local.get $hd)))
            (call $axpy (call $row (local.get $g) (local.get $b) (local.get $j) (local.get $T) (local.get $d) (local.get $vo)) (local.get $oi)
              (f32.load (i32.add (i32.add (local.get $a) (local.get $ab)) (i32.shl (local.get $j) (i32.const 2)))) (local.get $hd))
            (local.set $j (i32.add (local.get $j) (i32.const 1))) (br $lj)))
          (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $li)))
        (local.set $h (i32.add (local.get $h) (i32.const 1))) (br $lh)))
      (local.set $b (i32.add (local.get $b) (i32.const 1))) (br $lb))))
  ;; wstecz 2: przy gotowym dS (już ze skalą): gQ_i += dS[i,j] · K_j,  gK_j += dS[i,j] · Q_i
  (func (export "attBackQK") (param $q i32) (param $s i32) (param $g i32) (param $B i32) (param $T i32) (param $d i32) (param $nh i32)
    (local $b i32) (local $h i32) (local $i i32) (local $j i32) (local $hd i32) (local $sb i32) (local $ds f32) (local $qo i32) (local $ko i32)
    (local.set $hd (i32.div_u (local.get $d) (local.get $nh)))
    (block $bb (loop $lb (br_if $bb (i32.ge_u (local.get $b) (local.get $B)))
      (local.set $h (i32.const 0))
      (block $bh (loop $lh (br_if $bh (i32.ge_u (local.get $h) (local.get $nh)))
        (local.set $qo (i32.mul (local.get $h) (local.get $hd)))
        (local.set $ko (i32.add (local.get $d) (local.get $qo)))
        (local.set $i (i32.const 0))
        (block $bi (loop $li (br_if $bi (i32.ge_u (local.get $i) (local.get $T)))
          (local.set $sb (i32.add (local.get $s) (i32.shl (i32.mul (i32.add (i32.mul (i32.add (i32.mul (local.get $b) (local.get $nh)) (local.get $h)) (local.get $T)) (local.get $i)) (local.get $T)) (i32.const 2))))
          (local.set $j (i32.const 0))
          (block $bj (loop $lj (br_if $bj (i32.gt_u (local.get $j) (local.get $i)))
            (local.set $ds (f32.load (i32.add (local.get $sb) (i32.shl (local.get $j) (i32.const 2)))))
            (if (f32.ne (local.get $ds) (f32.const 0)) (then
              (call $axpy (call $row (local.get $g) (local.get $b) (local.get $i) (local.get $T) (local.get $d) (local.get $qo))
                          (call $row (local.get $q) (local.get $b) (local.get $j) (local.get $T) (local.get $d) (local.get $ko)) (local.get $ds) (local.get $hd))
              (call $axpy (call $row (local.get $g) (local.get $b) (local.get $j) (local.get $T) (local.get $d) (local.get $ko))
                          (call $row (local.get $q) (local.get $b) (local.get $i) (local.get $T) (local.get $d) (local.get $qo)) (local.get $ds) (local.get $hd))))
            (local.set $j (i32.add (local.get $j) (i32.const 1))) (br $lj)))
          (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $li)))
        (local.set $h (i32.add (local.get $h) (i32.const 1))) (br $lh)))
      (local.set $b (i32.add (local.get $b) (i32.const 1))) (br $lb))))
)
